 120          // 绘制全屏图像
 121          // 参数使用 code 关键字，因为动画数据必须存在 Flash 里
 122          void lcd_draw_frame(unsigned char code* img) {
 123   1          unsigned char x, y;
 124   1      
 125   1          // 上半屏刷新 (32行)
 126   1          for (y = 0; y < 32; y++) {
 127   2              lcd_write_cmd(0x80 | y);    // 设定垂直地址 Y
 128   2              lcd_write_cmd(0x80);        // 设定水平地址 X=0
 129   2              for (x = 0; x < 16; x++) {  // 128位 / 8 = 16字节
 130   3                  lcd_write_data(*img++);
 131   3              }
 132   2          }
 133   1      
 134   1          // 下半屏刷新 (32行)
 135   1          for (y = 0; y < 32; y++) {
 136   2              lcd_write_cmd(0x80 | y);    // 设定垂直地址 Y
 137   2              lcd_write_cmd(0x88);        // 设定水平地址 X=8 (下半屏起始)
 138   2              for (x = 0; x < 16; x++) {
 139   3                  lcd_write_data(*img++);
 140   3              }
 141   2          }
 142   1      }
