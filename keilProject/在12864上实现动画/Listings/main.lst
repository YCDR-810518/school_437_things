 136          
 137          //  2 帧数据，每帧 1024 字节
 138          unsigned char code* const frames[] = { frame1, frame2 };
 139          unsigned char current_frame = 0;
 140          bit update_flag = 0; // 动画更新标志位
 141          
 142          // 定时器初始化 (以 50ms 触发一次为例)
 143          void Timer0_Init(void) {
 144   1          TMOD |= 0x01;
 145   1          TH0 = 0x4C; TL0 = 0x00; // 50ms @ 12MHz
 146   1          ET0 = 1; EA = 1; TR0 = 1;
 147   1      }
 148          
 149          // 定时器中断服务函数
 150          void Timer0_ISR(void) interrupt 1 {
 151   1          static unsigned char count = 0;
 152   1          TH0 = 0x4C; TL0 = 0x00;
 153   1          count++;
 154   1          if (count >= 1) { // 50ms * 1 = 50ms 刷新一帧
 155   2              count = 0;
 156   2              update_flag = 1; // 告诉主循环：该刷新了
 157   2          }
 158   1      }
 159          
 160          void main() {
 161   1          lcd_init();
 162   1          lcd_graphic_mode(1);
 163   1          Timer0_Init(); // 启动节拍器
 164   1      
 165   1          while (1) {
 166   2              if (update_flag) {
 167   3                  update_flag = 0; // 清除标志
 168   3                  lcd_draw_frame(frames[current_frame]); // 这一瞬间，不被任何延时阻塞
 169   3                  current_frame++;
 170   3                  if (current_frame >= 1) current_frame = 0;
 171   3              }
 172   2          }
 173   1      }


